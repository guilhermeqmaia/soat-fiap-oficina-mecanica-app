DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oficina_mecanica?schema=public"
# TLS no banco (RDS exige): true no EKS, vazio localmente
DB_SSL=
PORT=3000
# Issuer aceito nos tokens (o emissor e a Lambda de CPF — US-F3-03)
# JWT_ISSUER=oficina-auth-lambda
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=1h
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081

LOG_LEVEL=debug

# Notificacoes outbound. Escolha UM provider:
#   mock    -> so loga (dev/demo sem dependencias)
#   email   -> envia e-mail de verdade via SMTP (nodemailer) — DEFAULT (Brevo)
#   webhook -> POST assinado (HMAC) para uma URL externa
NOTIFICATION_PROVIDER=email

# --- provider=email (SMTP via Brevo, free tier) ------------------------------
# Setup: crie conta em https://www.brevo.com, verifique um remetente e pegue as
# credenciais em Transactional > SMTP (login = e-mail da conta; senha = SMTP key).
# Enquanto SMTP_USER/SMTP_PASS estiverem vazios, o adapter usa uma conta de teste
# Ethereal (zero cadastro) e loga um link "preview=" para ver o e-mail no browser.
# Outros provedores: Gmail (smtp.gmail.com:587 + App Password), Mailtrap sandbox.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# No Brevo, o remetente precisa ser um e-mail/dominio verificado na conta.
EMAIL_FROM=Oficina Mecanica <nao-responda@oficina.local>

# --- provider=webhook --------------------------------------------------------
# Para demo, gere uma URL em https://webhook.site/ ou https://requestbin.com/
NOTIFICATION_WEBHOOK_URL=https://webhook.site/seu-token
NOTIFICATION_WEBHOOK_SECRET=change-me-webhook-secret
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000

# --- Mensageria (Fase 4, US-F4-06 / RFC-0006) -------------------------------
# Vazio => sobe sem broker: os eventos os.* ficam PENDENTES na tabela `outbox`.
# Local: `docker compose --profile messaging up -d localstack` e descomente abaixo.
# AWS: ARN/URL vem do stage `messaging/` do infra-k8s (ConfigMap no EKS).
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
AWS_REGION=us-east-1
# AWS_ENDPOINT=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-os.fifo
# SQS_QUEUE_URL=http://localhost:4566/000000000000/os-eventos.fifo
# MESSAGING_AUTOSTART=true   # false = poller/consumer parados (testes)
# OUTBOX_INTERVALO_MS=500

# --- Saga orquestrada (US-F4-10 / RFC-0005) ---------------------------------
# Timeouts que disparam compensacao: orcamento sem resposta e pagamento pendente.
# Para a demo use os overrides em ms (ex.: SAGA_TIMEOUT_APROVACAO_MS=120000).
SAGA_TIMEOUT_APROVACAO_DIAS=3
SAGA_TIMEOUT_PAGAMENTO_HORAS=24
# SAGA_TIMEOUT_APROVACAO_MS=
# SAGA_TIMEOUT_PAGAMENTO_MS=
# SAGA_TIMEOUTS_INTERVALO_MS=60000
