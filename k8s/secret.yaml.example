# Copie este arquivo para `k8s/secret.yaml`, substitua os valores e nunca
# versione o arquivo real. Ele esta protegido por `.gitignore`.
#
# O DATABASE_URL nao pertence a este Secret. Ele deve vir do Secret `oficina-db`,
# criado pelo Terraform da US-F2-06.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-app
  namespace: oficina
  labels:
    app.kubernetes.io/name: oficina-api
    app.kubernetes.io/part-of: oficina-mecanica
type: Opaque
stringData:
  JWT_SECRET: change-me-to-a-strong-random-secret
  WEBHOOK_APPROVAL_TOKEN: change-me-to-a-strong-webhook-approval-token
  NOTIFICATION_WEBHOOK_SECRET: change-me-to-a-strong-notification-webhook-secret
