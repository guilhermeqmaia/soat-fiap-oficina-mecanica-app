# TEMPLATE do Secret da aplicacao (`oficina-app`).
#
#   1. Copie:   cp k8s/secret.yaml.example k8s/secret.yaml
#   2. Edite os valores (gere segredos fortes).
#   3. NUNCA commite o `secret.yaml` real — ele esta no k8s/.gitignore.
#
# Contrato de Secrets (single-writer-per-Secret) — ver US-F2-05:
#   - `oficina-app` (ESTE arquivo): segredos da aplicacao.
#   - `oficina-db`  (Terraform, US-F2-06): contem DATABASE_URL. NAO entra aqui.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-app
  labels:
    app.kubernetes.io/name: oficina-app
    app.kubernetes.io/part-of: oficina-mecanica
    app.kubernetes.io/managed-by: kustomize
type: Opaque
stringData:
  # Obrigatorio. Em producao precisa de >= 32 caracteres e nao pode ser placeholder.
  # Gere com:  openssl rand -base64 48
  JWT_SECRET: "TROQUE_POR_openssl_rand_base64_48_com_no_minimo_32_chars"
  # Token esperado pelo webhook de aprovacao/reprovacao de orcamento (US-F2-02).
  WEBHOOK_APPROVAL_TOKEN: "TROQUE_POR_token_forte_do_webhook_de_aprovacao"
  # Segredo HMAC usado para assinar as notificacoes outbound (US-F2-02 / notificacao).
  NOTIFICATION_WEBHOOK_SECRET: "TROQUE_POR_segredo_hmac_do_webhook_de_notificacao"
  # Senha SMTP do provider=email. Para Gmail use uma App Password de 16 digitos;
  # para Brevo use a SMTP key. Se tambem existir no ConfigMap, o Secret prevalece.
  # SMTP_PASS: "sua-senha-ou-chave-smtp"
