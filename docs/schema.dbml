// Auto Repair Shop - Entity Relationship Diagram
// Import this file at https://dbdiagram.io
// Justificativa do banco, relacionamentos e indices: docs/arquitetura/banco-de-dados.md

Project oficina_mecanica {
  database_type: 'PostgreSQL'
  Note: 'Sistema Integrado de Oficina Mecanica - Tech Challenge FIAP'
}

Enum Role {
  ADMIN
  ATENDENTE
  MECANICO
  ESTOQUISTA
  CLIENTE
}

Enum StatusOrdemDeServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  AGUARDANDO_PAGAMENTO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

Enum TipoNotificacao {
  ORCAMENTO_PRONTO
  OS_FINALIZADA
  STATUS_OS_ALTERADO
}

Enum CanalNotificacao {
  EMAIL
}

Enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHOU
}

Table usuario {
  id uuid [pk, default: `uuid_generate_v4()`]
  nome varchar [not null]
  email varchar [unique, not null]
  senha_hash varchar [not null]
  role Role [not null]
  ativo boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table cliente {
  id uuid [pk, default: `uuid_generate_v4()`]
  nome varchar [not null]
  cpf_cnpj varchar [unique, not null, note: 'CPF or CNPJ, validated in domain']
  email varchar
  telefone varchar [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table veiculo {
  id uuid [pk, default: `uuid_generate_v4()`]
  cliente_id uuid [not null, ref: > cliente.id]
  placa varchar [unique, not null, note: 'Brazilian plate: old or Mercosul format']
  marca varchar [not null]
  modelo varchar [not null]
  ano int [not null]
  ativo boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table ordem_de_servico {
  id uuid [pk, default: `uuid_generate_v4()`]
  numero varchar [unique, not null]
  cliente_id uuid [not null, ref: > cliente.id]
  veiculo_id uuid [not null, ref: > veiculo.id]
  usuario_id uuid [ref: > usuario.id]
  descricao_inicial varchar [not null]
  diagnostico text
  status StatusOrdemDeServico [not null, default: 'RECEBIDA']
  motivo_cancelamento varchar [note: 'Preenchido quando CANCELADA: compensacao da saga ou OPERADOR']
  version int [not null, default: 0, note: 'Lock otimista (HTTP x consumidores SQS)']
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table item_ordem_de_servico_servico {
  id uuid [pk, default: `uuid_generate_v4()`]
  ordem_de_servico_id uuid [not null, ref: > ordem_de_servico.id]
  servico_id uuid [not null, note: 'Referencia logica ao catalogo do Execucao Service (sem FK)']
  nome varchar [not null, note: 'Snapshot: nome congelado no diagnostico']
  quantidade int [not null]
  preco_unitario decimal [not null, note: 'Snapshot: preco congelado no diagnostico']
  created_at timestamp [default: `now()`]

  indexes {
    (ordem_de_servico_id, servico_id) [unique]
  }
}

Table item_ordem_de_servico_produto {
  id uuid [pk, default: `uuid_generate_v4()`]
  item_ordem_de_servico_servico_id uuid [not null, ref: > item_ordem_de_servico_servico.id]
  produto_id uuid [not null, note: 'Referencia logica ao estoque do Execucao Service (sem FK)']
  nome varchar [not null, note: 'Snapshot: nome congelado no diagnostico']
  quantidade int [not null]
  preco_unitario decimal [not null, note: 'Snapshot: preco congelado no diagnostico']
  created_at timestamp [default: `now()`]

  indexes {
    (item_ordem_de_servico_servico_id, produto_id) [unique]
  }
}

Table ordem_de_servico_audit_log {
  id uuid [pk, default: `uuid_generate_v4()`]
  ordem_de_servico_id uuid [not null, ref: > ordem_de_servico.id]
  acao varchar [not null]
  status_anterior varchar
  status_novo varchar
  usuario_id uuid
  metadata json
  created_at timestamp [default: `now()`]

  indexes {
    (ordem_de_servico_id, created_at)
  }
}

// cliente_id e ordem_de_servico_id sao referencias LOGICAS (sem FK fisica):
// a notificacao e um registro imutavel de envio, desacoplado do ciclo de vida
// de cliente/OS. Ver docs/arquitetura/banco-de-dados.md > "Relacionamentos".
Table notificacao {
  id uuid [pk, default: `uuid_generate_v4()`]
  cliente_id uuid [not null, note: 'Referencia logica a cliente.id (sem FK)']
  ordem_de_servico_id uuid [note: 'Referencia logica a ordem_de_servico.id (sem FK)']
  tipo TipoNotificacao [not null]
  canal CanalNotificacao [not null]
  destinatario varchar [not null]
  assunto varchar [not null]
  mensagem varchar [not null]
  status StatusNotificacao [not null]
  erro varchar
  enviada_em timestamp
  created_at timestamp [default: `now()`]

  indexes {
    cliente_id
    ordem_de_servico_id
  }
}

// ─── Mensageria (ADR-0009): contratos do kit @guilhermeqmaia/oficina-kit ───

Table outbox {
  id varchar [pk, note: 'id do envelope (UUID v7) = MessageDeduplicationId']
  type varchar [not null, note: 'os.aberta | os.cancelada | os.finalizada | os.entregue']
  correlation_id varchar [not null, note: 'numero da OS = MessageGroupId']
  envelope jsonb [not null]
  status varchar [not null, default: 'PENDENTE', note: 'PENDENTE | ENVIADA | FALHA']
  tentativas int [not null, default: 0]
  criada_em timestamp [default: `now()`]
  enviada_em timestamp
  ultimo_erro varchar

  indexes {
    (status, criada_em)
  }
}

Table processed_messages {
  id varchar [pk, note: 'id do envelope consumido (dedup da fila os-eventos)']
  type varchar [not null]
  processada_em timestamp [default: `now()`, note: 'purga apos 7 dias']

  indexes {
    processada_em
  }
}
