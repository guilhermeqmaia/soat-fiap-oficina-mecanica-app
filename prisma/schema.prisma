generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      Role
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ordensDeServico OrdemDeServico[]

  @@map("usuario")
}

enum Role {
  ADMIN
  ATENDENTE
  MECANICO
  ESTOQUISTA
  CLIENTE
}

model Servico {
  id                 String   @id @default(uuid())
  nome               String
  descricao          String?
  precoBase          Decimal  @map("preco_base")
  tempoEstimadoHoras Float    @map("tempo_estimado_horas")
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  itensOrdemDeServico ItemOrdemDeServicoServico[]

  @@map("servico")
}

model Produto {
  id                   String   @id @default(uuid())
  nome                 String
  descricao            String?
  precoUnitario        Decimal  @map("preco_unitario")
  quantidadeEstoque    Int      @map("quantidade_estoque")
  quantidadeReservada  Int      @default(0) @map("quantidade_reservada")
  estoqueMinimo        Int      @map("estoque_minimo")
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("produto")
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  cpfCnpj   String   @unique @map("cpf_cnpj")
  email     String?
  telefone  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  veiculos  Veiculo[]
  ordensDeServico OrdemDeServico[]

  @@map("cliente")
}

model Veiculo {
  id        String   @id @default(uuid())
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int
  clienteId String   @map("cliente_id")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  ordensDeServico OrdemDeServico[]

  @@map("veiculo")
}

model OrdemDeServico {
  id                  String   @id @default(uuid())
  numero              String   @unique
  clienteId           String   @map("cliente_id")
  veiculoId           String   @map("veiculo_id")
  usuarioId           String?  @map("usuario_id")
  descricaoInicial    String   @map("descricao_inicial")
  diagnostico         String?
  status              StatusOrdemDeServico @default(RECEBIDA)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  itensServico ItemOrdemDeServicoServico[]

  @@map("ordem_de_servico")
}

model ItemOrdemDeServicoServico {
  id               String             @id @default(uuid())
  ordemDeServicoId String             @map("ordem_de_servico_id")
  servicoId        String             @map("servico_id")
  quantidade       Int
  precoUnitario    Decimal            @map("preco_unitario")
  statusExecucao   StatusExecucaoItem @default(PENDENTE) @map("status_execucao")
  inicioExecucao   DateTime?          @map("inicio_execucao")
  fimExecucao      DateTime?          @map("fim_execucao")
  horasTrabalhadas Float?             @map("horas_trabalhadas")
  createdAt        DateTime           @default(now()) @map("created_at")

  ordemDeServico OrdemDeServico @relation(fields: [ordemDeServicoId], references: [id], onDelete: Cascade)
  servico        Servico        @relation(fields: [servicoId], references: [id])

  @@unique([ordemDeServicoId, servicoId])
  @@map("item_ordem_de_servico_servico")
}

enum StatusExecucaoItem {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDO
}

enum StatusOrdemDeServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

model Notificacao {
  id               String             @id @default(uuid())
  clienteId        String             @map("cliente_id")
  ordemDeServicoId String?            @map("ordem_de_servico_id")
  tipo             TipoNotificacao
  canal            CanalNotificacao
  destinatario     String
  assunto          String
  mensagem         String
  status           StatusNotificacao
  erro             String?
  enviadaEm        DateTime?          @map("enviada_em")
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([clienteId])
  @@index([ordemDeServicoId])
  @@map("notificacao")
}

enum TipoNotificacao {
  ORCAMENTO_PRONTO
  OS_FINALIZADA
}

enum CanalNotificacao {
  EMAIL
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHOU
}
